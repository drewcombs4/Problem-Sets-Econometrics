##########
#make a null and alternative hypothesis for the effect of a democratic president on GDP -- this is a on-sided hypothesis
#H_0: beta_1 =0 (No effect of Democratic president on GDP)
#H_A: beta_1 > 0 (Democratic president has a positive effect on GDP)

##########
#what are the corresponding critical values?
#0.01 
alpha <- 0.01
critical_value_0.01_gdp <- qt(1 - alpha, df) # One-tailed test
print(paste("Critical value for alpha = 0.01 (GDP):", critical_value_0.01_gdp))

#0.05
alpha <- 0.05
critical_value_0.05_gdp <- qt(1 - alpha, df) # One-tailed test
print(paste("Critical value for alpha = 0.05 (GDP):", critical_value_0.05_gdp))

#0.1
alpha <- 0.1
critical_value_0.1_gdp <- qt(1 - alpha, df) # One-tailed test
print(paste("Critical value for alpha = 0.1 (GDP):", critical_value_0.1_gdp))

##########
#Let's estimate a model with GDP per capita as the dependent variable -- what do the coefficients mean? what has changed from the previous regression?
model_gdp <- lm(gdp ~ lagdempres, data = pres_data)
summary(model_gdp)

# Interpretation:
# beta_0 (Intercept): The average GDP per capita when there is NOT a Democratic president in office in the PREVIOUS year.
# beta_1 (lagdempres): The change in average GDP per capita associated with having a Democratic president in office in the PREVIOUS year.
# Change: The dependent variable is now gdp instead of unem.

